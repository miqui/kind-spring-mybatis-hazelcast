# 1Password CLI Environment Configuration for Kind Cluster Deployment
#
# Usage:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Update the op:// URIs to match your 1Password vault, item, and field names:
#      op://<vault>/<item>/<field>
#   3. Run deployment using op run:
#      op run --env-file=.env -- ./deploy-kind.sh

# PostgreSQL Credentials (Database + Container)
DB_USER="op://dev-vault/k8s-postgres/username"
DB_PASSWORD="op://dev-vault/k8s-postgres/password"
POSTGRES_USER="op://dev-vault/k8s-postgres/username"
POSTGRES_PASSWORD="op://dev-vault/k8s-postgres/password"

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER="op://dev-vault/k8s-grafana/username"
GF_SECURITY_ADMIN_PASSWORD="op://dev-vault/k8s-grafana/password"

# OpenObserve Credentials (Root User & Remote-Write Authentication)
ZO_ROOT_USER_EMAIL="op://dev-vault/k8s-openobserve/username"
ZO_ROOT_USER_PASSWORD="op://dev-vault/k8s-openobserve/password"
